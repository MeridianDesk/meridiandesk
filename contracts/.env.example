# Copy to .env and fill locally. Never commit .env (it's in .gitignore).

# RPC — Alchemy is the official provider in docs.robinhood.com/chain/connecting
RH_RPC_TESTNET=https://robinhood-testnet.g.alchemy.com/v2/<ALCHEMY_KEY>
RH_RPC_MAINNET=https://robinhood-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>
# fallbacks: https://rpc.testnet.chain.robinhood.com · https://robinhood-sepolia-rpc.publicnode.com
#            https://robinhood.drpc.org · https://robinhood-rpc.publicnode.com

# Deployer — prefer a keystore over a raw key:
#   cast wallet import meridian-deployer --interactive   → then pass --account meridian-deployer
DEPLOYER_ADDRESS=

# Deploy.s.sol
USDG=           # collateral token on the target chain (testnet: deploy MockERC20 if none exists)
ADMIN=          # Safe multisig — receives every admin role (testnet: may be your own EOA)
GUARDIAN=       # optional hot key: pause only, cannot unpause
QUOTER=         # options RFQ signer ADDRESS (never its key)
DEPOSIT_CAP=50000000000   # 50,000 USDG (6 decimals)

# ListMarkets.s.sol (after deploy)
REGISTRY=
